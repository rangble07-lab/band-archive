# Copy to .env.local for local dev (do not commit secrets)

# Required for edit unlock (default in code is 1234 if unset — change this)
VITE_EDIT_PIN=1234

# Optional — without these, the app stores data in the browser (localStorage)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
